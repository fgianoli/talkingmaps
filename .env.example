# ─── Database ───
POSTGRES_DB=talkingmaps_data
POSTGRES_USER=talkingmaps
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://talkingmaps:changeme_in_production@db:5432/talkingmaps_data
DATABASE_SYSTEM_URL=postgresql+asyncpg://talkingmaps:changeme_in_production@db:5432/talkingmaps_system

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── Backend ───
SECRET_KEY=changeme-generate-a-random-secret-key
ALLOWED_ORIGINS=http://localhost:8080
UPLOAD_DIR=/var/www/uploads
MAX_UPLOAD_SIZE_MB=50

# ─── JWT ───
JWT_EXPIRE_MINUTES=480

# ─── Initial Admin ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ─── OAuth Providers (optional) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Crea le storymap di esempio pubbliche al primo avvio (backend/demo/*.json)
SEED_DEMO_STORIES=false
